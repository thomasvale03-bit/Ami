# Copy these into Railway's Variables tab (never commit real values).
AMY_MODE=dry-run                 # dry-run -> test -> live
TEST_GUEST_EMAIL_ALLOWLIST=valeconsultingaz@gmail.com
AMY_POLL_SECONDS=120
# Required for test and live: Unix time to start from (older requests are ignored)
AMY_START_AFTER=
# Secrets from the Google OAuth setup
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Posh signups are booked automatically only when this is true: set it once the
# Posh checkout requires 21+ and authorizes Playmaker to register the guest on
# the TAO guest list (TAO authorization sections 3-4). Otherwise they go to the team.
POSH_CONSENT_ON_FILE=false
